#!/bin/sh
# git-guard pre-commit：提交前扫描暂存区
# 绕过：git commit --no-verify

GUARD_HOME="${GIT_GUARD_HOME:-$HOME/.git-guard}"
SCAN="$GUARD_HOME/scan.py"

if [ ! -f "$SCAN" ]; then
  echo "[git-guard] 未安装扫描器（$SCAN），跳过检查。"
  exit 0
fi

# 逐个探测：`python3` 在 Windows 上可能是 Microsoft Store 的占位存根
#（存在、能执行、但不是解释器）。只认「能跑起空脚本」的那一个。
find_python() {
  for c in python3 python py; do
    p=$(command -v "$c" 2>/dev/null) || continue
    [ -n "$p" ] || continue
    if "$p" -c "" >/dev/null 2>&1; then
      printf '%s' "$p"
      return 0
    fi
  done
  return 1
}

PY=$(find_python)
if [ -z "$PY" ]; then
  echo "[git-guard] 警告：找不到可用的 Python 解释器，提交前检查未执行。"
  exit 0
fi

# 输出重定向到文件/CI 日志时，中文与 ✓ 在 cp936 下会抛 UnicodeEncodeError，
# 那会被当成 exit 2 从而锁死提交。这里固定 UTF-8 输出。
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
export PYTHONIOENCODING PYTHONUTF8

"$PY" "$SCAN" --staged
rc=$?
if [ $rc -eq 2 ]; then
  echo "[git-guard] 扫描器异常（exit 2）。如确需提交：git commit --no-verify"
  exit 1
fi
exit $rc
